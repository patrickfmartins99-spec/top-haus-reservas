rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A equipe autenticada pode acompanhar somente o fluxo de avisos em tempo real.
    // Criação e alteração continuam exclusivas das rotas protegidas do servidor.
    match /staffNotifications/{notificationId} {
      allow read: if request.auth != null && request.auth.token.staff == true;
      allow write: if false;
    }

    // All application access goes through authenticated server routes.
    // Admin SDK (including the paused robot) is not affected by these client rules.
    match /{document=**} { allow read, write: if false; }
  }
}
